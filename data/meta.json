  "stacks": [
    {
      "name": "User-interface sans",
      "fonts": [
        "Helvetica Neue",
        "Roboto",
        "Segoe UI",
        "Arial"
      ],
      "generic": "sans-serif",
      "lead": "system-ui",
      "note": "Starting with system-ui hands iOS and macOS their San Francisco face, which has no public name. The named fonts are what each platform offers next."
    },
    {
      "name": "Grotesque sans",
      "fonts": [
        "Helvetica Neue",
        "Helvetica",
        "Roboto",
        "Arial"
      ],
      "generic": "sans-serif"
    },
    {
      "name": "Humanist sans",
      "fonts": [
        "Gill Sans",
        "Corbel",
        "Source Sans Pro",
        "Tahoma",
        "Verdana"
      ],
      "generic": "sans-serif"
    },
    {
      "name": "Geometric sans",
      "fonts": [
        "Avenir Next",
        "Avenir",
        "Futura",
        "Bahnschrift",
        "Roboto"
      ],
      "generic": "sans-serif"
    },
    {
      "name": "Condensed sans",
      "fonts": [
        "Avenir Next Condensed",
        "DIN Condensed",
        "Arial Narrow",
        "Bahnschrift",
        "Roboto"
      ],
      "generic": "sans-serif",
      "note": "Nothing on Android is condensed. Roboto is the fallback so text still fits the same family."
    },
    {
      "name": "Old-style serif",
      "fonts": [
        "Baskerville",
        "Palatino",
        "Palatino Linotype",
        "Noto Serif",
        "Georgia"
      ],
      "generic": "serif"
    },
    {
      "name": "Transitional serif",
      "fonts": [
        "Georgia",
        "Charter",
        "Cambria",
        "Noto Serif",
        "Times New Roman"
      ],
      "generic": "serif"
    },
    {
      "name": "Didone serif",
      "fonts": [
        "Didot",
        "Bodoni 72",
        "Constantia",
        "Georgia",
        "Noto Serif"
      ],
      "generic": "serif",
      "note": "Only Apple ships a true didone. Constantia and Georgia keep the contrast high elsewhere."
    },
    {
      "name": "Slab serif",
      "fonts": [
        "Rockwell",
        "American Typewriter",
        "Kefa",
        "Georgia",
        "Noto Serif"
      ],
      "generic": "serif",
      "note": "Only Apple platforms carry a slab; the rest fall to a plain serif."
    },
    {
      "name": "Monospace",
      "fonts": [
        "Menlo",
        "Consolas",
        "Cascadia Mono",
        "Droid Sans Mono",
        "Courier New"
